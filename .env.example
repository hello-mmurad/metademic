# ── Metademic owner configuration ──────────────────────────────
# Public values also live in content/site.ts. Secrets never go there.

NEXT_PUBLIC_SITE_URL=              # e.g. https://metademic.org
NEXT_PUBLIC_JOURNAL_URL=
NEXT_PUBLIC_JOURNAL_SUBMIT_URL=
NEXT_PUBLIC_BLOG_URL=              # blog subdomain
BLOG_FEED_URL=                     # RSS/Atom/JSON feed of the blog (server-side)
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=   # POST endpoint for subscriptions
NEXT_PUBLIC_RACON_URL=             # future RACoN subdomain
NEXT_PUBLIC_RACON_REPO=            # e.g. https://github.com/metademic/racon
NEXT_PUBLIC_RACON_DOCS_URL=
NEXT_PUBLIC_RACON_SPONSOR_URL=
NEXT_PUBLIC_GITHUB_URL=            # organization URL
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_DONATE_URL=            # Buy-us-a-coffee destination
GITHUB_TOKEN=                      # optional, server-side only; raises API rate limits